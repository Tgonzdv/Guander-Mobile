<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Icon container -->
        <TextView
            android:id="@+id/tv_reward_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="🎁"
            android:textSize="26sp" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_reward_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre recompensa"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_reward_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_reward_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="800 pts"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canjear button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reward_canjear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canjear"
            android:textSize="12sp"
            android:textColor="?attr/colorOnPrimary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
