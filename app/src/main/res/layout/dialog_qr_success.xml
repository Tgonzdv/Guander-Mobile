<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_rounded_bg"
    android:padding="24dp">

    <!-- Green check circle -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="✓"
        android:textSize="30sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/circle_green"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PetPoints Ganados!"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu consumo fue validado exitosamente"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Points badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/badge_yellow_rounded"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏅"
            android:textSize="20sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_points_earned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+7"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PetPoints ganados"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="14dp" />

    <!-- Store info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_light_bg"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_store_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veterinaria Patitas"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_item_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del producto"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monto $7,300"
            android:textSize="12sp"
            android:textColor="#212121" />
    </LinearLayout>

    <!-- New balance -->
    <TextView
        android:id="@+id/tv_new_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo balance: 1,250 PetPoints"
        android:textSize="12sp"
        android:textColor="@color/green_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_great"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="¡Genial!"
        android:textColor="@color/white"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="10dp" />

</LinearLayout>
