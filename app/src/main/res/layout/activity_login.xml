<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appbar_green"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="36dp"
    android:paddingTop="48dp"
    android:paddingBottom="40dp">

    <!-- Logo -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/guander_logo"
        android:background="@drawable/login_logo_bg"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="Guander logo" />

    <!-- App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:letterSpacing="0.05"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Accedé o creá tu cuenta"
        android:textColor="#A8C8A0"
        android:textSize="15sp" />

    <!-- Sign in button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:text="Iniciar sesión con Google"
        android:textColor="#1B4D2E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconTint="@null" />

    <!-- Register button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google_register"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="Registrarse con Google"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconTint="@null"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1.5dp" />

    <!-- Loading indicator (hidden by default) -->
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="#FFFFFF" />

    <!-- Divider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#4D7A5A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="o continúa con email"
            android:textColor="#A8C8A0"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#4D7A5A" />
    </LinearLayout>

    <!-- Email field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_email"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:hint="Correo electrónico"
        app:boxBackgroundColor="#00000000"
        app:boxStrokeColor="#FFFFFF"
        app:boxStrokeWidth="1.5dp"
        app:hintTextColor="#A8C8A0"
        app:startIconDrawable="@android:drawable/ic_dialog_email"
        app:startIconTint="#A8C8A0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#A8C8A0" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_password"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="Contraseña"
        app:boxBackgroundColor="#00000000"
        app:boxStrokeColor="#FFFFFF"
        app:boxStrokeWidth="1.5dp"
        app:endIconMode="password_toggle"
        app:endIconTint="#A8C8A0"
        app:hintTextColor="#A8C8A0"
        app:startIconDrawable="@android:drawable/ic_lock_lock"
        app:startIconTint="#A8C8A0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#A8C8A0" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Email login button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_email_login"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Iniciar sesión con email"
        android:textColor="#1B4D2E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="28dp" />

    <!-- Email register button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_email_register"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Registrarse con email"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1.5dp" />

</LinearLayout>
</ScrollView>