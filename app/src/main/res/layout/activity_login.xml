<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B4D2E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <!-- Logo -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/guander_logo"
        android:background="@drawable/login_logo_bg"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="Guander logo" />

    <!-- App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:letterSpacing="0.05"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Accedé o creá tu cuenta"
        android:textColor="#A8C8A0"
        android:textSize="15sp" />

    <!-- Sign in button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:text="Iniciar sesión con Google"
        android:textColor="#1B4D2E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconTint="@null" />

    <!-- Register button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google_register"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="Registrarse con Google"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1.5dp" />

    <!-- Loading indicator (hidden by default) -->
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="#FFFFFF" />

</LinearLayout>