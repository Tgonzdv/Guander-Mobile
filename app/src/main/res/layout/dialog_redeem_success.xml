<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:padding="24dp">

    <!-- Green check circle -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="✓"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/shape_avatar_circle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="¡Canje Exitoso!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="Tu recompensa ha sido canjeada correctamente"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:textAlignment="center" />

    <!-- Code card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/shape_code_card_bg"
        android:padding="16dp"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codigo de Canje"
            android:textSize="11sp"
            android:textColor="#CCFFFFFF" />

        <TextView
            android:id="@+id/tv_redemption_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUAN-0000"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presenta este codigo en el local"
            android:textSize="11sp"
            android:textColor="#BBFFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Entendido button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_understood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Entendido"
        android:textColor="@color/white"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="24dp" />
</LinearLayout>
