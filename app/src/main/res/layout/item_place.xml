<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: icon + name/desc + heart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_place_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_place_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del lugar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_place_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#FFA000"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_place_schedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="♡"
                android:textSize="20sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Distance + points badge row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_place_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.5 km · Abierto ahora"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Address row -->
        <TextView
            android:id="@+id/tv_place_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:drawablePadding="4dp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- Detail button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Ver detalles y comentarios"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
